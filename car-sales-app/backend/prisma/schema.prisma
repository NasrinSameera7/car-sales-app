// Prisma schema for the Car Sales Marketplace
// Uses PostgreSQL — works out of the box with free hosted DBs
// (Railway, Neon, Supabase, Render Postgres) which is what most
// hosting platforms expect for a public, multi-user app.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (port 6543, via Supabase's pgbouncer) — used at runtime
  // by the running app, where connections are short-lived and frequent.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used only for running migrations, which
  // need a non-pooled connection. Supabase requires this split.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  DEALER
}

enum ListingStatus {
  AVAILABLE
  SOLD
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  city         String?
  createdAt    DateTime @default(now())

  listings      CarListing[]      @relation("SellerListings")
  purchases     Purchase[]        @relation("BuyerPurchases")
  sales         Purchase[]        @relation("SellerSales")
  wishlist      Wishlist[]
  sentMessages  Message[]         @relation("SentMessages")
  conversationsA Conversation[]   @relation("ParticipantA")
  conversationsB Conversation[]   @relation("ParticipantB")
  friendRequestsSent     Friendship[] @relation("FriendRequester")
  friendRequestsReceived Friendship[] @relation("FriendAddressee")
}

model CarListing {
  id               String        @id @default(cuid())
  seller           User          @relation("SellerListings", fields: [sellerId], references: [id])
  sellerId         String
  year             Int
  make             String        @default("")
  variant          String
  color            String
  fuelType         FuelType
  insuranceDetails String
  kmRun            Int
  owners           Int
  price            Int           @default(0)
  status           ListingStatus @default(AVAILABLE)
  description      String        @default("")
  createdAt        DateTime      @default(now())

  photos       Photo[]
  wishlistedBy Wishlist[]
  conversations Conversation[]
  purchase     Purchase?
}

model Photo {
  id     String     @id @default(cuid())
  url    String
  car    CarListing @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId  String
}

model Purchase {
  id         String   @id @default(cuid())
  car        CarListing @relation(fields: [carId], references: [id])
  carId      String   @unique
  buyer      User     @relation("BuyerPurchases", fields: [buyerId], references: [id])
  buyerId    String
  seller     User     @relation("SellerSales", fields: [sellerId], references: [id])
  sellerId   String
  soldAt     DateTime @default(now())
}

model Wishlist {
  id       String     @id @default(cuid())
  user     User       @relation(fields: [userId], references: [id])
  userId   String
  car      CarListing @relation(fields: [carId], references: [id])
  carId    String
  addedAt  DateTime   @default(now())

  @@unique([userId, carId])
}

model Friendship {
  id          String       @id @default(cuid())
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id])
  requesterId String
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id])
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([requesterId, addresseeId])
}

model Conversation {
  id             String    @id @default(cuid())
  car            CarListing? @relation(fields: [carId], references: [id])
  carId          String?
  participantA   User      @relation("ParticipantA", fields: [participantAId], references: [id])
  participantAId String
  participantB   User      @relation("ParticipantB", fields: [participantBId], references: [id])
  participantBId String
  createdAt      DateTime  @default(now())

  messages Message[]

  @@unique([participantAId, participantBId, carId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  senderId       String
  text           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
}
