# --- Supabase Postgres connection ---
# Get both of these from: Supabase Dashboard -> your project -> Connect
# (or Project Settings -> Database -> Connection string)
#
# DATABASE_URL = "Transaction pooler" string (port 6543) — used by the app at runtime.
# DIRECT_URL   = "Direct connection" string (port 5432) — used only for migrations.
# Both use the same password (the database password you set when creating the project).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Any long random string — used to sign login tokens.
JWT_SECRET="change-this-to-a-long-random-string"

# Port the API server listens on.
PORT=4000

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN="http://localhost:5173"

# --- Optional: only needed if you switch photo storage to Supabase Storage
# instead of local disk (see SUPABASE_SETUP.md, step 5). Leave blank otherwise.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="car-photos"
